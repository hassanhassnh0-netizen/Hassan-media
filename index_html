<style>
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Arial,Helvetica,sans-serif;background:#05070d;color:#fff;line-height:1.6;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(circle at 10% 20%,rgba(47,140,255,.08),transparent 25%),radial-gradient(circle at 90% 80%,rgba(91,80,255,.07),transparent 25%);z-index:-1}
a{text-decoration:none;color:inherit}
nav{display:flex;justify-content:space-between;align-items:center;padding:22px 7%;position:sticky;top:0;background:#08111fee;backdrop-filter:blur(10px);z-index:5}
.logo-wrap{display:flex;align-items:center;gap:10px}
.logo-mark{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;background:linear-gradient(135deg,#2f8cff,#6a5cff);font-size:12px;font-weight:900;box-shadow:0 8px 25px rgba(47,140,255,.25)}
.logo{font-size:21px;font-weight:800}.logo span{color:#2f8cff}
nav ul{display:flex;gap:28px;list-style:none;color:#c9d4e3;font-size:14px}
nav li a{transition:.25s}nav li a:hover{color:#53a3ff}
.btn{display:inline-block;background:linear-gradient(135deg,#2f8cff,#5967ff);color:white;padding:13px 22px;border-radius:9px;font-weight:700;box-shadow:0 10px 30px rgba(47,140,255,.22);transition:.3s;position:relative;overflow:hidden}.btn:hover{transform:translateY(-3px);box-shadow:0 15px 35px rgba(47,140,255,.35)}.btn span{margin-left:7px}
.hero{min-height:82vh;display:flex;align-items:center;padding:80px 7%;background:radial-gradient(circle at 80% 30%,#123b69 0,transparent 35%)}
.hero-content{max-width:700px;animation:fadeUp .9s ease both}.tag{color:#53a3ff;font-weight:700;letter-spacing:2px;text-transform:uppercase;font-size:13px}
h1{font-size:clamp(46px,7vw,78px);line-height:1.02;margin:18px 0;letter-spacing:-2px}.hero p{font-size:19px;color:#b7c4d5;max-width:610px;margin-bottom:30px}
@keyframes fadeUp{from{opacity:0;transform:translateY(25px)}to{opacity:1;transform:none}}
@keyframes float{50%{transform:translateY(-8px)}}
section{padding:85px 7%}.section-title{text-align:center;margin-bottom:45px}.section-title h2{font-size:40px}.section-title p{color:#9eacbd;margin-top:10px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{background:linear-gradient(145deg,#101d2f,#0d1929);border:1px solid #1c3048;border-radius:16px;padding:28px;transition:.3s;animation:fadeUp .7s ease both}.card:hover{transform:translateY(-8px);border-color:#2f8cff;box-shadow:0 18px 45px rgba(0,0,0,.25)}.icon{font-size:30px;margin-bottom:15px;animation:float 3s ease-in-out infinite}.card h3{margin-bottom:8px}.card p{color:#9eacbd}
.about{background:#0c1727}.about-box{max-width:900px;margin:auto;text-align:center}.about-box p{color:#b7c4d5;font-size:18px}
.cta{text-align:center;background:linear-gradient(135deg,#0d2542,#102b4c)}.cta h2{font-size:42px;margin-bottom:12px}.cta p{color:#b7c4d5;margin-bottom:25px}
footer{padding:30px 7%;display:flex;justify-content:space-between;color:#8190a3;font-size:14px;border-top:1px solid #14253a}.socials a{transition:.2s}.socials a:hover{color:#53a3ff}
.chat-actions{position:fixed;right:24px;bottom:24px;display:flex;gap:10px;z-index:10}.wa-float,.chatgpt-float{width:58px;height:58px;border-radius:50%;display:grid;place-items:center;color:#fff;font-size:25px;box-shadow:0 10px 30px rgba(0,0,0,.35);animation:float 2.5s ease-in-out infinite}.wa-float{background:#25D366}.chatgpt-float{background:#111b29;border:1px solid #2c4058}
@media(max-width:800px){nav ul{display:none}.grid{grid-template-columns:1fr}.hero{min-height:70vh;padding-top:60px}footer{display:block;text-align:center}.hero p{font-size:17px}}
.contact-form{max-width:620px;margin:30px auto 18px;display:grid;gap:14px;text-align:left}.contact-form input,.contact-form textarea{width:100%;padding:15px 16px;border-radius:10px;border:1px solid #29415d;background:#0a1625;color:#fff;font:inherit;outline:none}.contact-form input:focus,.contact-form textarea:focus{border-color:#2f8cff;box-shadow:0 0 0 3px rgba(47,140,255,.12)}.contact-form textarea{resize:vertical}.contact-form button{border:0;cursor:pointer}.contact-links{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}.small-note{font-size:12px!important;color:#8091a6!important;margin-top:18px!important}.message-float{padding:13px 20px;border-radius:12px;display:grid;place-items:center;color:#fff;font-size:15px;font-weight:700;background:linear-gradient(135deg,#2f8cff,#5967ff);box-shadow:0 10px 30px rgba(0,0,0,.35);animation:float 2.5s ease-in-out infinite}

