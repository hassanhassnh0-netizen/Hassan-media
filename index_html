.card{background:linear-gradient(145deg,rgba(17,22,34,.96),rgba(8,12,20,.96));border:1px solid rgba(215,181,109,.13);box-shadow:0 18px 60px rgba(0,0,0,.20)}
.card:hover{border-color:rgba(215,181,109,.65);box-shadow:0 22px 70px rgba(215,181,109,.10)}
.about{background:linear-gradient(180deg,#080c14,#0a0e17)}
.cta{background:linear-gradient(135deg,#111016,#0b101a);border-top:1px solid rgba(215,181,109,.12);border-bottom:1px solid rgba(215,181,109,.12)}
